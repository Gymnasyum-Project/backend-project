# ==========================================
# KONFIGURASI SERVER & APLIKASI
# ==========================================
# Mode lingkungan aplikasi: development, production, atau test
NODE_ENV=development

# Port tempat server Express berjalan secara lokal
PORT=5000

# Alamat URL frontend yang diizinkan mengakses API (CORS)
CORS_ORIGIN=http://localhost:5173

# ==========================================
# DATABASE (POSTGRESQL / AIVEN)
# ==========================================
# String koneksi utama ke database PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/gymnasyum"

# (Opsional) Path ke file sertifikat SSL CA jika menggunakan database cloud seperti Aiven
# DB_CA_PATH="./ca.pem"

# ==========================================
# AUTENTIKASI & KEAMANAN (JWT)
# ==========================================
# Kunci rahasia untuk menandatangani token login JWT (minimal 32 karakter)
JWT_SECRET="ganti_dengan_string_acak_yang_panjang"

# Masa berlaku token JWT sebelum user diminta login ulang (contoh: 8h, 1d)
JWT_EXPIRES_IN=1d

# ==========================================
# INTEGRASI SERVICE AI & MACHINE LEARNING
# ==========================================
# Endpoint service ML untuk menghitung prediksi risiko & priority score member
INFERENCE_URL=http://localhost:8001

# Endpoint service RAG / LLM (Modal) untuk generate ringkasan analisis & draf follow-up AI
RAG_URL=http://localhost:8000

# API Key untuk autentikasi request dari backend ke service RAG / LLM
RAG_API_KEY="api_key_rag_kamu"

# ==========================================
# KEAMANAN WEBHOOK & VERCEL CRON JOBS
# ==========================================
# Token rahasia untuk memvalidasi request webhook internal antar-service
INTERNAL_WEBHOOK_SECRET="gymnasyum_2026"

# Token rahasia untuk memvalidasi bahwa endpoint /api/cron/* hanya dipicu oleh Vercel Cron
CRON_SECRET="gymnasyum_cron_2026"