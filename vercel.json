{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/batch-predict",
      "schedule": "0 20 * * *"
    },{
      "path": "/api/cron/batch-summary",
      "schedule": "15 20 * * *"
    }
  ]
}